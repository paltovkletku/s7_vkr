@startuml
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 145
skinparam ParticipantBackgroundColor white
skinparam ActivityBackgroundColor white
skinparam LifeLineBackgroundColor white
skinparam SequenceGroupHeaderBackgroundColor white
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 18
participant "Автор" as A
participant "Веб-приложение" as W
participant "Хранилище\nзаданий и выпусков" as D
participant "Обработчик\nзаданий" as J
participant "Статический\nанализатор" as K

== Постановка задания ==
alt Обычная проверка
  A -> W : «Проверить»
else Финальная проверка
  A -> W : «Проверить перед публикацией»
end
W -> D : Поставить задание\nс режимом, снимком и сроком
activate D
D --> W : Номер задания
deactivate D
W --> A : Подтверждение и номер

== Проверка ==
J -> D : Взять задание из очереди
activate J
activate D
D --> J : Режим, снимок и срок
deactivate D
J -> K : Проверить сценарий
activate K
K --> J : Статус и диагностика
deactivate K
J -> D : Сохранить отчёт и статус
activate D
D --> J : Итог сохранён
deactivate D
deactivate J

== Отчёт и готовность ==
A -> W : Открыть статус задания
activate W
W -> D : Прочитать итог и\nактуальный снимок
activate D
D --> W : Режим, статус, отчёт и версия
deactivate D
alt Обычная проверка
  W --> A : Отчёт
else Финальная проверка пройдена, снимок актуален, глава очередная
  W --> A : Отчёт и статус «Готова к публикации»
else Глава не готова по итогам финальной проверки
  W --> A : Отчёт и причина отказа в готовности
end
deactivate W

== Отдельная команда публикации ==
opt Автор решает опубликовать главу
  A -> W : «Опубликовать»
  activate W
  W -> D : Создать выпуск после сверки\nпроверки, снимка и порядка глав
  activate D
  alt Финальная проверка пройдена для текущего снимка, глава очередная
    D --> W : Выпуск зафиксирован
    W --> A : Глава опубликована
  else Снимок изменился после финальной проверки
    D --> W : Проверка устарела
    W --> A : Нужна новая финальная проверка
  else Успешной финальной проверки нет
    D --> W : Нет подходящего результата проверки
    W --> A : Нужна успешная финальная проверка
  else Нарушен порядок глав
    D --> W : Глава не очередная
    W --> A : Публикация недоступна.\nПроверьте порядок глав
  end
  deactivate D
  deactivate W
end
@enduml
